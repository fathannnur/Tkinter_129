import tkinter as tk

def hasil_prediksi():
    hasil.config(text="Hasil Prediksi: Teknologi Informasi", fg="green")

top = tk.Tk()
top.title("Aplikasi Prediksi Prodi Pilihan")
top.geometry("650x500")
top.configure(bg="white")

judul = tk.Label(
    top,
    text="Aplikasi Prediksi Prodi Pilihan",
    font=("Times New Roman", 16, "bold"),
    bg="white",
    fg="blue"
)
judul.pack(pady=20)

f = tk.Frame(top, bg="white")
f.pack()

nilai = []

for i in range(10):
    label = tk.Label(
        f,
        text="Nilai Mata Pelajaran " + str(i + 1),
        bg="white"
    )
    label.grid(row=i, column=0, padx=10, pady=5, sticky="w")

    entry = tk.Entry(f)
    entry.grid(row=i, column=1, padx=10, pady=5)

    nilai.append(entry)

tombol = tk.Button(
    top,
    text="Hasil Prediksi",
    command=hasil_prediksi,
    bg="gray",
    fg="white"
)
tombol.pack(pady=20)

hasil = tk.Label(
    top,
    text="Hasil prediksi akan muncul di sini",
    bg="white",
    fg="black",
    font=("Times New Roman", 11)
)
hasil.pack()

top.mainloop()